{
  "version": 2,
  "outputDirectory": "web",
  "functions": {
    "api/render.js": {
      "includeFiles": "templates/**"
    },
    "api/resume.js": {
      "includeFiles": "data/resume*.json"
    },
    "api/jobs.js": {
      "includeFiles": "data/jobs-cache.json"
    },
    "api/optimize.js": {
      "maxDuration": 60
    },
    "api/talent.js": {
      "includeFiles": "data/talent-*.json"
    },
    "api/project-ideas.js": {
      "includeFiles": "data/{jobs-cache,resume,project-ideas-cache}.json",
      "maxDuration": 60
    },
    "api/ats-score.js": {
      "includeFiles": "data/jobs-cache.json"
    },
    "api/events.js": {
      "includeFiles": "data/events-cache.json",
      "maxDuration": 30
    },
    "api/articles.js": {
      "includeFiles": "data/articles-cache.json",
      "maxDuration": 30
    },
    "api/learning.js": {
      "includeFiles": "data/{jobs-cache,resume,learning-catalog,project-ideas-cache}.json",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/study-plan",
      "destination": "/api/learning?endpoint=study-plan"
    },
    {
      "source": "/api/learning-budget",
      "destination": "/api/learning?endpoint=budget"
    },
    {
      "source": "/api/export-docx",
      "destination": "/api/render?format=docx"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
