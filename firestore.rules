rules_version = '2';

// Regras do Firestore do projeto exclusivo do Career Studio / ATS-vagas (jobs-3a608).
// Cada usuária só lê e grava o próprio espaço: careerStudio/{uid} e tudo abaixo dele.
// Qualquer outro caminho do banco é negado.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /careerStudio/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid)
          // limite de segurança: nenhum documento acima de ~900 KB
          && (request.resource == null || request.resource.size() < 900000);
      }
    }
  }
}
